{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "generateOptions": {
    "defaultLibraryPrefix": "libs"
  },
  "sourceRoot": "apps/mrhalal-api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/mrhalal-api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/mrhalal-api",
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "mrhalal-api": {
      "type": "application",
      "root": "apps/mrhalal-api",
      "entryFile": "main",
      "sourceRoot": "apps/mrhalal-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/mrhalal-api/tsconfig.app.json"
      }
    },
    "mrhalal-batch": {
      "type": "application",
      "root": "apps/mrhalal-batch",
      "entryFile": "main",
      "sourceRoot": "apps/mrhalal-batch/src",
      "compilerOptions": {
        "tsConfigPath": "apps/mrhalal-batch/tsconfig.app.json"
      }
    },
    "prisma": {
      "type": "library",
      "root": "libs/prisma",
      "entryFile": "index",
      "sourceRoot": "libs/prisma/src",
      "compilerOptions": {
        "tsConfigPath": "libs/prisma/tsconfig.lib.json"
      }
    },
    "types": {
      "type": "library",
      "root": "libs/types",
      "entryFile": "index",
      "sourceRoot": "libs/types/src",
      "compilerOptions": {
        "tsConfigPath": "libs/types/tsconfig.lib.json"
      }
    }
  }
}